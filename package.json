{
  "name": "pwa-starter-kit",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Squelette d'application PWA de la famille miss-* / mister-* : la composition que chaque app réécrivait — fournisseurs, routes, écrans de cadre, i18n, backend à repli local, mise à jour du service worker — assemblée sur @mister-guiiug/dev-pwa-config et prête à cloner.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pwa-bundle-budget && pwa-doctor --strict",
    "build:analyze": "cross-env ANALYZE=1 npm run build",
    "preview": "vite preview --base /pwa-starter-kit/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "type-check": "tsc -b",
    "doctor": "pwa-doctor",
    "icons": "pwa-icons --source public/favicon.svg --out public --maskable --bg 59,110,165",
    "prepare": "husky || true",
    "screenshots": "pwa-screenshots --wide-path reglages"
  },
  "bundleBudget": {
    "totalGzipKb": 210,
    "mainChunkKb": 430
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.4",
    "@mister-guiiug/dev-pwa-config": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "tailwindcss": "^4.2.2",
    "zod": "^4.0.0",
    "zustand": "^5.0.12"
  }
}
